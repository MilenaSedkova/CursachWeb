  "testimonials": [
   {
      "id": "1",
      "avatar": "pictures/HomepageImages/woman.png",
      "starsImage": "pictures/HomepageImages/Star.svg",
      "text": "The quality of the organic vegetables is outstanding. Delivery is always on time, and customer support is incredibly helpful!",
      "textRu": "Качество органических овощей превосходное. Доставка всегда вовремя, а служба поддержки невероятно отзывчива!",
      "name": "Sara Taylor",
      "nameRu": "Сара Тейлор",
      "role": "Consumer",
      "roleRu": "Покупатель"
    },
    {
      "id": "2",
      "avatar": "pictures/HomepageImages/man2.png",
      "starsImage": "pictures/HomepageImages/Star.svg",
      "text": "I've been buying here for a year. The fresh fruits are amazing. My family loves it, highly recommend to everyone who cares about health.",
      "textRu": "Покупаю здесь уже год. Свежие фрукты просто восхитительны. Моей семье они очень нравятся, настоятельно рекомендую всем, кто заботится о здоровье.",
      "name": "John Anderson",
      "nameRu": "Джон Андерсон",
      "role": "Food Blogger",
      "roleRu": "Фуд-блогер"
    },
    {
      "id": "3",
      "avatar": "pictures/HomepageImages/woman2.png",
      "starsImage": "pictures/HomepageImages/Star.svg",
      "text": "Great service and top-notch products! The organic nuts and seeds are exactly what I need for my daily diet.",
      "textRu": "Отличный сервис и первоклассные продукты! Органические орехи и семена — это именно то, что мне нужно для моего ежедневного рациона.",
      "name": "Emily Carter",
      "nameRu": "Эмили Картер",
      "role": "Consumer",
      "roleRu": "Покупатель"
    },
    {
      "id": "4",
      "avatar": "pictures/HomepageImages/woman3.png",
      "starsImage": "pictures/HomepageImages/Star.svg",
      "text": "Very convenient store. The interface is simple, the checkout is fast, and the quality of the products exceeds expectations.",
      "textRu": "Очень удобный магазин. Интерфейс простой, оформление заказа быстрое, а качество продуктов превосходит все ожидания.",
